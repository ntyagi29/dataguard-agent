# Copy this file to .env and fill in your values

# Optional: Set your Anthropic API key here to enable AI analysis by default
# You can also enter it in the UI directly
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Resend API key for email notifications (https://resend.com)
RESEND_API_KEY=re_your-key-here

# Port to run the server on (default: 3000)
PORT=3000

# Optional: GitHub OAuth (https://github.com/settings/developers → New OAuth App)
#   Homepage URL: https://dataguard.dataquality.health
#   Callback URL: https://dataguard.dataquality.health/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional: GitLab OAuth (https://gitlab.com/-/user_settings/applications)
#   Callback URL: https://dataguard.dataquality.health/api/auth/gitlab/callback
#   Scopes: api, read_user
GITLAB_CLIENT_ID=your-gitlab-client-id
GITLAB_CLIENT_SECRET=your-gitlab-client-secret
GITLAB_URL=https://gitlab.com

# Public URL of this app — used as OAuth redirect base
APP_URL=https://dataguard.dataquality.health
